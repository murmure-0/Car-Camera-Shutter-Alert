# Auto detect text files and perform LF normalization
* text=auto

# Source code files - force LF line endings
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.pro text eol=lf
*.pri text eol=lf
*.cmake text eol=lf
*.css text eol=lf
*.js text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows-specific files - force CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files - don't touch
*.a binary
*.so binary
*.o binary
*.lib binary
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.rknn binary
*.SLDPRT binary
*.SLDASM binary
*.step binary
*.epro2 binary
*.uvprojx binary
*.uvoptx binary
